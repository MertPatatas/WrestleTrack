# Variables de entorno de WrestleTrack. Copia este archivo como .env.local para desarrollo
# y pon las mismas en Vercel → Settings → Environment Variables.

# --- Supabase (cuentas y base de datos) --- las crea la integración de Supabase en Vercel.
# Sin ellas la app funciona sin inicio de sesión (útil para desarrollar el diseño).
NEXT_PUBLIC_SUPABASE_URL=
# Clave pública: según la versión de la integración se llama ANON_KEY o PUBLISHABLE_KEY
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Conexión a Postgres por el pooler. Las tablas (esquema "app") se crean solas la primera vez.
POSTGRES_URL=
# Clave de servicio (secreta, solo en el servidor): se usa para eliminar cuentas
SUPABASE_SERVICE_ROLE_KEY=

# --- Textos legales ---
# Email de contacto que aparece en la Política de privacidad y las Condiciones
# (opcional: por defecto Wrestle.Track.app@gmail.com)
NEXT_PUBLIC_CONTACT_EMAIL=

# --- Notificaciones push (Web Push / VAPID) ---
# Genera un par con: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contacto para los servicios de push: mailto:tu@email o una URL https
VAPID_SUBJECT=

# --- Avisos programados (Upstash QStash) --- las crea la integración de Upstash en Vercel.
# QStash llama a /api/push/dispatch cada 5 minutos; con estas claves se comprueba que la llamada es suya.
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# Clave propia para lanzar los avisos a mano: Authorization: Bearer <CRON_SECRET>
CRON_SECRET=
